# Multi-stage build for fake-logic
# Stage 1: Builder
FROM eclipse-temurin:21-jdk-alpine AS builder

WORKDIR /build
COPY . .

RUN ./mvnw clean package -DskipTests -pl fake-logic -q

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine

LABEL maintainer="Kafka Sidecar Team"
LABEL description="Fake Logic - Receives orders and creates shipments"

WORKDIR /app

# Copy JAR from builder stage
COPY --from=builder /build/fake-logic/target/fake-logic-0.0.1-SNAPSHOT.jar app.jar

# Expose REST API port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/api/orders/list || exit 1

# Run application
ENTRYPOINT ["java", "-jar", "app.jar"]

