# Runtime image for fake-logic
FROM eclipse-temurin:21-jre-alpine
LABEL maintainer="Kafka Sidecar Team"
LABEL description="Fake Logic - Processes orders and creates shipments"
WORKDIR /app
# Copy pre-built JAR from local target directory
COPY fake-logic/target/fake-logic-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8080
# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/api/orders/list || exit 1
# Run application
ENTRYPOINT ["java", "-jar", "app.jar"]
