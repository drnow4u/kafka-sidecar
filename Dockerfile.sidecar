# Runtime image for kafka-sidecar
FROM eclipse-temurin:21-jre-alpine
LABEL maintainer="Kafka Sidecar Team"
LABEL description="Kafka Sidecar - Bridges Kafka and REST for order processing"
WORKDIR /app
# Copy pre-built JAR from local target directory
COPY kafka-sidecar/target/kafka-sidecar-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8080
# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/actuator/health || exit 1
# Run application
ENTRYPOINT ["java", "-jar", "app.jar"]
