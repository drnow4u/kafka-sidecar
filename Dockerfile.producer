# Multi-stage build for fake-producer
# Stage 1: Builder
FROM eclipse-temurin:21-jdk-alpine AS builder

WORKDIR /build
COPY . .

RUN ./mvnw clean package -DskipTests -pl fake-producer -q

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine

LABEL maintainer="Kafka Sidecar Team"
LABEL description="Fake Producer - Generates fake orders every 1 second to Kafka"

WORKDIR /app

# Copy JAR from builder stage
COPY --from=builder /build/fake-producer/target/fake-producer-0.0.1-SNAPSHOT.jar app.jar

# Expose no ports (producer only sends to Kafka)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# Run application
ENTRYPOINT ["java", "-jar", "app.jar"]

