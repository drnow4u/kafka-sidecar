# Runtime image for fake-producer
FROM eclipse-temurin:25-jre-alpine

LABEL maintainer="Kafka Sidecar Team"
LABEL description="Fake Producer - Generates fake orders every 1 second to Kafka"

WORKDIR /app

# Copy pre-built JAR from local target directory
COPY fake-producer/target/fake-producer-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# Run application
ENTRYPOINT ["java", "-jar", "app.jar"]

