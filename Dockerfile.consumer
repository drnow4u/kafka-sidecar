# Runtime image for fake-consumer
FROM eclipse-temurin:25-jre-alpine
LABEL maintainer="Kafka Sidecar Team"
LABEL description="Fake Consumer - Receives shipments and manages deliveries"
WORKDIR /app
# Copy pre-built JAR from local target directory
COPY fake-consumer/target/fake-consumer-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8081
# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8081/api/shipments/health || exit 1
# Run application
ENTRYPOINT ["java", "-jar", "app.jar"]
